# DPO Admin Portal — no secrets here. Copy to .env and fill in.
# Base URL of the DPO backend (proposed admin contract must be confirmed first).
VITE_DPO_API_BASE_URL=
# Public website URL used for "view public page" links.
VITE_DPO_PUBLIC_SITE_URL=
# Show "Users & permissions" menu only when backend auth/admin API exists.
VITE_DPO_AUTH_ENABLED=false
